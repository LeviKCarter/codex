# Allowlist: this folder is a workspace holding other repos, secrets and scratch
# data, so ignore everything and opt files in explicitly.
*
!.gitignore
!CLAUDE.md
# Project skills (the rest of .claude/, worktrees included, stays ignored).
!.claude/
!.claude/skills/
!.claude/skills/pulse-canvas/
!.claude/skills/pulse-canvas/**
# Global skills kept here for backup: ~/.claude/skills/<name> is a junction to skills/<name> in the main checkout.
# They are outside .claude/skills on purpose, so a session does not load them twice.
!.gitattributes
!skills/
!skills/ship/
!skills/ship/**
!skills/archive-finished/
!skills/archive-finished/**
!skills/spotify-artists/
!skills/spotify-artists/**
!skills/held-cart/
!skills/held-cart/**
# Userscripts published from this repo, each opted in by name: any other folder or file under userscripts/ (the
# PC's local block-filter extension source, for one) stays ignored.
!userscripts/
!userscripts/AGENTS.md
!userscripts/Reddit-Quick-Mute-Mobile.user.js
!userscripts/Uber-Trip-History.user.js
!userscripts/Uber-Trip-History.test.mjs
!userscripts/maps-links/
!userscripts/maps-links/**
# The job that answers the WoW addon's item lookups (the addon itself lives in the game folder, not in git).
!wow/
# Which client the wow tools work on: the Forever beta or the new _forever_ one (wow/forever-uptime/Set-WoWClient.ps1).
!wow/wow_client.py
!wow/test_wow_client.py
!wow/afp-lookup/
!wow/afp-lookup/answer_lookups.py
!wow/afp-lookup/test_answer_lookups.py
!wow/afp-lookup/register_task.ps1
# The WoW Forever taskbar shortcut's update check, red dot and "back up" notification (generated icon and logs stay out).
!wow/forever-uptime/
!wow/forever-uptime/*.ps1
# The job that watches the forum for the beta going down and coming back, and the two outages its tests replay.
!wow/forever-uptime/watch_beta.py
!wow/forever-uptime/test_watch_beta.py
!wow/forever-uptime/fixtures/
!wow/forever-uptime/fixtures/outages-2026-10.json
# WoW Forever: takes addons' hooks off Blizzard's frame methods before each launch.
!wow/addon-hook-patches/
!wow/addon-hook-patches/patch_addon_hooks.py
!wow/addon-hook-patches/test_patch_addon_hooks.py
!wow/addon-hook-patches/mapframe_harness.lua
!wow/addon-hook-patches/bag_harness.lua
# Skyborne's map-pin patch text (patch_addon_hooks.py part()) and the test of the patched addon.
!wow/addon-hook-patches/skyborne/
!wow/addon-hook-patches/skyborne/map-pins.original.lua
!wow/addon-hook-patches/skyborne/map-pins.patched.lua
!wow/addon-hook-patches/skyborne/test_overlay.py
# GatherMate2's world map patch text and its test (GatherMate2 is GPL v2).
!wow/addon-hook-patches/gathermate2/
!wow/addon-hook-patches/gathermate2/world-map.original.lua
!wow/addon-hook-patches/gathermate2/world-map.patched.lua
!wow/addon-hook-patches/gathermate2/test_world_map.py
!wow/addon-hook-patches/gathermate2/hbd-pins.original.lua
!wow/addon-hook-patches/gathermate2/hbd-pins.patched.lua
!wow/addon-hook-patches/gathermate2/test_hbd_pins.py
# WoW Forever: before each launch, finds addon code that breaks the controller and has Claude fix it (reports/ and
# backups/ stay out).
!wow/addon-guard/
!wow/addon-guard/addon_guard.py
!wow/addon-guard/test_addon_guard.py
!wow/addon-guard/accepted.json
# WoW Forever: when Blizzard patches the game, Claude reads the staff notes and fixes the addons before Levi logs in
# (reports/, backups/ and shortcut-before/ stay out).
!wow/patch-day/
!wow/patch-day/patch_day.py
!wow/patch-day/test_patch_day.py
!wow/patch-day/run_suite.py
!wow/patch-day/register_task.ps1
!wow/patch-day/RULES.md
# The job that sends Claude the evidence when WoW crashes or hangs (its reports/ folder, the evidence itself, stays out).
!wow/crash-report/
!wow/crash-report/watch_crashes.py
!wow/crash-report/test_watch_crashes.py
!wow/crash-report/register_task.ps1
!wow/crash-report/Notify-Crash.ps1
!wow/crash-report/KNOWN.md
